# Optional Colab-hosted chatbot inference service. The backend calls this API;
# the browser/frontend should continue calling this project's /api routes.
CHATBOT_ENABLED=false
COLAB_INFERENCE_URL=
COLAB_INFERENCE_CHAT_ENDPOINT=/chat
COLAB_INFERENCE_API_KEY=
COLAB_INFERENCE_TIMEOUT_SECONDS=180
COLAB_INFERENCE_HISTORY_LIMIT=20

# Local development only; the deployed Compose stack uses hosted PostgreSQL.
POSTGRES_PASSWORD=change-me-for-local-development
