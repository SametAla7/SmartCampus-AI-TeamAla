# Environment variables for SmartCampus AI
# Copy this file to .env and fill in your values. Do NOT commit .env.

# Prisma Postgres (pooled connection) - paste your Prisma Postgres connection string here
# Example format (do not use real credentials in this file):
# DATABASE_URL="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL=

# Optional: direct connection URL for migrations (if provided by Prisma)
# DATABASE_URL_DIRECT=

# Application
APP_ENV=development
JWT_SECRET=change-me-in-production

# CORS (comma-separated in some setups; pydantic-settings can parse JSON list)
# CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Frontend (links in emails, redirect target after OAuth login)
FRONTEND_URL=http://localhost:4200

# SMTP (email sending). Leave SMTP_HOST empty to disable: emails are then only logged.
# Gmail example: smtp.gmail.com / 587 / STARTTLS / use an "App Password", not your real password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SmartCampus AI
PASSWORD_RESET_EXPIRE_MINUTES=30

# Google OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, "Web application")
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/auth/oauth/google/callback
