# Environment variables for SmartCampus AI
# Copy this file to .env and fill in your values. Do NOT commit .env.

# Prisma Postgres (pooled connection) - paste your Prisma Postgres connection string here
# Example format (do not use real credentials in this file):
# DATABASE_URL="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL=

# Optional: direct connection URL for migrations (if provided by Prisma)
# DATABASE_URL_DIRECT=

# Application
APP_ENV=development
JWT_SECRET=change-me-in-production

# CORS (comma-separated in some setups; pydantic-settings can parse JSON list)
# CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Optional Colab-hosted chatbot inference service. The backend calls this API;
# the browser/frontend should continue calling this project's /api routes.
CHATBOT_ENABLED=false
COLAB_INFERENCE_URL=
COLAB_INFERENCE_CHAT_ENDPOINT=/chat
COLAB_INFERENCE_API_KEY=
COLAB_INFERENCE_TIMEOUT_SECONDS=180
COLAB_INFERENCE_HISTORY_LIMIT=20

# Local development only; the deployed Compose stack uses hosted PostgreSQL.
POSTGRES_PASSWORD=change-me-for-local-development
